[
  { "id": "n5_grammar_wa_desu", "type": "grammar", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-self-introduction", "japanese": "A は B です", "reading": "A wa B desu", "romaji": null, "meaning": "A is B", "explanation": "Used to state that A is B. は marks the topic.", "metadata": { "pattern": "A は B です", "examples": [{ "ja": "私は学生です。", "kana": "わたしはがくせいです。", "en": "I am a student." }] } },
  { "id": "n5_grammar_no", "type": "grammar", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-self-introduction", "japanese": "A の B", "reading": "A no B", "romaji": null, "meaning": "A's B / B of A", "explanation": "Connects two nouns. A の B means 'B of A' or 'A's B'.", "metadata": { "pattern": "A の B", "examples": [{ "ja": "私の友達", "kana": "わたしのともだち", "en": "my friend" }] } },
  { "id": "n5_grammar_ka", "type": "grammar", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-self-introduction", "japanese": "〜か", "reading": "ka", "romaji": null, "meaning": "question marker", "explanation": "Adding か at the end of a sentence turns it into a question.", "metadata": { "pattern": "〜か", "examples": [{ "ja": "学生ですか。", "kana": "がくせいですか。", "en": "Are you a student?" }] } },

  { "id": "n5_grammar_ni", "type": "grammar", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-daily-life", "japanese": "A に B", "reading": "A ni B", "romaji": null, "meaning": "at/in/to A (location)", "explanation": "に marks a location or time. For existence, use に with いる/ある.", "metadata": { "pattern": "A に B", "examples": [{ "ja": "学校に行きます。", "kana": "がっこうにいきます。", "en": "I go to school." }] } },
  { "id": "n5_grammar_de", "type": "grammar", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-daily-life", "japanese": "A で B", "reading": "A de B", "romaji": null, "meaning": "at A (action location)", "explanation": "で marks the location where an action takes place. に marks existence; で marks activity.", "metadata": { "pattern": "A で B", "examples": [{ "ja": "家で勉強します。", "kana": "いえでべんきょうします。", "en": "I study at home." }] } },
  { "id": "n5_grammar_wo", "type": "grammar", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-daily-life", "japanese": "A を B", "reading": "A wo B", "romaji": null, "meaning": "A (direct object)", "explanation": "を marks the direct object of a verb.", "metadata": { "pattern": "A を B", "examples": [{ "ja": "水を飲みます。", "kana": "みずをのみます。", "en": "I drink water." }] } },

  { "id": "n5_grammar_tai", "type": "grammar", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-food-drink", "japanese": "〜たい", "reading": "tai", "romaji": null, "meaning": "want to ~", "explanation": "Replace the masu-stem of a verb with たい to say 'want to do something'.", "metadata": { "pattern": "Verb-stem + たい", "examples": [{ "ja": "ご飯を食べたいです。", "kana": "ごはんをたべたいです。", "en": "I want to eat a meal." }] } },
  { "id": "n5_grammar_hoshii", "type": "grammar", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-food-drink", "japanese": "〜が欲しい", "reading": "ga hoshii", "romaji": null, "meaning": "want (something)", "explanation": "Use が欲しい to say you want a thing or object.", "metadata": { "pattern": "Noun + が欲しい", "examples": [{ "ja": "水が欲しいです。", "kana": "みずがほしいです。", "en": "I want water." }] } },
  { "id": "n5_grammar_de_particles", "type": "grammar", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-food-drink", "japanese": "〜で食べる", "reading": "de taberu", "romaji": null, "meaning": "eat at/with ~", "explanation": "で can also mean 'with' or 'by means of' indicating the tool or method.", "metadata": { "pattern": "Tool + で + verb", "examples": [{ "ja": "箸で食べます。", "kana": "はしでたべます。", "en": "I eat with chopsticks." }] } },

  { "id": "n5_grammar_masu", "type": "grammar", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-basic-verbs", "japanese": "〜ます", "reading": "masu", "romaji": null, "meaning": "polite verb form", "explanation": "Replace dictionary form with ます form for polite present/future tense.", "metadata": { "pattern": "Verb-stem + ます", "examples": [{ "ja": "学校に行きます。", "kana": "がっこうにいきます。", "en": "I go to school." }] } },
  { "id": "n5_grammar_masen", "type": "grammar", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-basic-verbs", "japanese": "〜ません", "reading": "masen", "romaji": null, "meaning": "polite negative", "explanation": "Replace ます with ません for polite negative.", "metadata": { "pattern": "Verb-stem + ません", "examples": [{ "ja": "朝ご飯を食べません。", "kana": "あさごはんをたべません。", "en": "I do not eat breakfast." }] } },
  { "id": "n5_grammar_mashita", "type": "grammar", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-basic-verbs", "japanese": "〜ました", "reading": "mashita", "romaji": null, "meaning": "polite past", "explanation": "Replace ます with ました for polite past tense.", "metadata": { "pattern": "Verb-stem + ました", "examples": [{ "ja": "昨日勉強しました。", "kana": "きのうべんきょうしました。", "en": "I studied yesterday." }] } }
]
