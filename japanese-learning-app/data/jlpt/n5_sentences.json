[
  { "id": "n5_sentence_001", "type": "sentence", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-self-introduction", "japanese": "私は学生です。", "reading": "わたしはがくせいです。", "romaji": "watashi wa gakusei desu", "meaning": "I am a student.", "metadata": { "grammarIds": ["n5_grammar_wa_desu"], "vocabIds": ["n5_vocab_watashi", "n5_vocab_gakusei"] } },
  { "id": "n5_sentence_002", "type": "sentence", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-self-introduction", "japanese": "私は友達と日本語を勉強します。", "reading": "わたしはともだちとにほんごをべんきょうします。", "romaji": "watashi wa tomodachi to nihongo o benkyoushimasu", "meaning": "I study Japanese with my friend.", "metadata": { "grammarIds": ["n5_grammar_wa_desu", "n5_grammar_wo"], "vocabIds": ["n5_vocab_watashi", "n5_vocab_tomodachi", "n5_vocab_nihongo"] } },
  { "id": "n5_sentence_003", "type": "sentence", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-self-introduction", "japanese": "私の先生ですか。", "reading": "わたしのせんせいですか。", "romaji": "watashi no sensei desu ka", "meaning": "Are you my teacher?", "metadata": { "grammarIds": ["n5_grammar_no", "n5_grammar_ka"], "vocabIds": ["n5_vocab_watashi", "n5_vocab_sensei"] } },

  { "id": "n5_sentence_004", "type": "sentence", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-daily-life", "japanese": "学校に行きます。", "reading": "がっこうにいきます。", "romaji": "gakkou ni ikimasu", "meaning": "I go to school.", "metadata": { "grammarIds": ["n5_grammar_ni", "n5_grammar_masu"], "vocabIds": ["n5_vocab_gakkou", "n5_vocab_iku"] } },
  { "id": "n5_sentence_005", "type": "sentence", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-daily-life", "japanese": "家で勉強します。", "reading": "いえでべんきょうします。", "romaji": "ie de benkyoushimasu", "meaning": "I study at home.", "metadata": { "grammarIds": ["n5_grammar_de", "n5_grammar_masu"], "vocabIds": ["n5_vocab_ie"] } },
  { "id": "n5_sentence_006", "type": "sentence", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-daily-life", "japanese": "朝、家を出ます。", "reading": "あさ、いえをでます。", "romaji": "asa, ie o demasu", "meaning": "I leave home in the morning.", "metadata": { "grammarIds": ["n5_grammar_wo", "n5_grammar_masu"], "vocabIds": ["n5_vocab_asa", "n5_vocab_ie_deru"] } },
  { "id": "n5_sentence_007", "type": "sentence", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-daily-life", "japanese": "学校に先生がいます。", "reading": "がっこうにせんせいがいます。", "romaji": "gakkou ni sensei ga imasu", "meaning": "There is a teacher at school.", "metadata": { "grammarIds": ["n5_grammar_ni"], "vocabIds": ["n5_vocab_gakkou", "n5_vocab_sensei"] } },

  { "id": "n5_sentence_008", "type": "sentence", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-food-drink", "japanese": "ご飯を食べます。", "reading": "ごはんをたべます。", "romaji": "gohan o tabemasu", "meaning": "I eat a meal.", "metadata": { "grammarIds": ["n5_grammar_wo", "n5_grammar_masu"], "vocabIds": ["n5_vocab_gohan", "n5_vocab_taberu"] } },
  { "id": "n5_sentence_009", "type": "sentence", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-food-drink", "japanese": "水が欲しいです。", "reading": "みずがほしいです。", "romaji": "mizu ga hoshii desu", "meaning": "I want water.", "metadata": { "grammarIds": ["n5_grammar_hoshii"], "vocabIds": ["n5_vocab_mizu"] } },
  { "id": "n5_sentence_010", "type": "sentence", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-food-drink", "japanese": "果物を食べたいです。", "reading": "くだものをたべたいです。", "romaji": "kudamono o tabetai desu", "meaning": "I want to eat fruit.", "metadata": { "grammarIds": ["n5_grammar_tai", "n5_grammar_wo"], "vocabIds": ["n5_vocab_kudamono", "n5_vocab_taberu"] } },
  { "id": "n5_sentence_011", "type": "sentence", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-food-drink", "japanese": "お茶を飲みました。", "reading": "おちゃをのみました。", "romaji": "ocha o nomimashita", "meaning": "I drank tea.", "metadata": { "grammarIds": ["n5_grammar_wo", "n5_grammar_mashita"], "vocabIds": ["n5_vocab_ocha", "n5_vocab_nomu"] } },

  { "id": "n5_sentence_012", "type": "sentence", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-basic-verbs", "japanese": "日本語を話します。", "reading": "にほんごをはなします。", "romaji": "nihongo o hanashimasu", "meaning": "I speak Japanese.", "metadata": { "grammarIds": ["n5_grammar_wo", "n5_grammar_masu"], "vocabIds": ["n5_vocab_nihongo", "n5_vocab_hanasu"] } },
  { "id": "n5_sentence_013", "type": "sentence", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-basic-verbs", "japanese": "本を読みません。", "reading": "ほんをよみません。", "romaji": "hon o yomimasen", "meaning": "I do not read books.", "metadata": { "grammarIds": ["n5_grammar_wo", "n5_grammar_masen"], "vocabIds": ["n5_vocab_yomu"] } },
  { "id": "n5_sentence_014", "type": "sentence", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-basic-verbs", "japanese": "日本語で手紙を書きます。", "reading": "にほんごでてがみをかきます。", "romaji": "nihongo de tegami o kakimasu", "meaning": "I write a letter in Japanese.", "metadata": { "grammarIds": ["n5_grammar_de", "n5_grammar_wo", "n5_grammar_masu"], "vocabIds": ["n5_vocab_nihongo", "n5_vocab_kaku"] } },
  { "id": "n5_sentence_015", "type": "sentence", "level": "N5", "moduleId": "jlpt-n5", "lessonId": "n5-basic-verbs", "japanese": "昨日、日本語を勉強しました。", "reading": "きのう、にほんごをべんきょうしました。", "romaji": "kinou, nihongo o benkyoushimashita", "meaning": "I studied Japanese yesterday.", "metadata": { "grammarIds": ["n5_grammar_wo", "n5_grammar_mashita"], "vocabIds": ["n5_vocab_nihongo"] } }
]
